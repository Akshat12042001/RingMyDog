__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={TERMS_AND_CONDITIONS_SCREEN:{TITLE:'TERMS & CONDITIONS / PRIVACY POLICY',ACCEPT_TERMS:'Accept Terms & Conditions / Privacy Policy',HTML:"<!DOCTYPE html>\n  <html lang=\"en\">\n  \n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Privacy Policy - Ring My Dog Limited</title>\n    <style>\n      /* Add your styles here */\n    </style>\n  </head>\n  \n  <body>\n    <div>\n    </div>\n    </div>\n    </div>\n  \n  \n  \n  \n    </div>\n    <div>\n      <div>\n  \n  \n  \n  \n        <div>\n  \n  \n  \n  \n          <div>\n            <p style=\"font-weight: bold; color: #5C2508;\">Ring My Dog Limited understands that your privacy is very important to you and that you care how\n              your personal data is used and shared online.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\" >We at Ring My Dog Limited respect and value the privacy of everyone who visits our website\n              www.ringmydog.com</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We will only collect and use personal data in ways that are described here, and in such a manner\n              that is consistent with Our Obligations and your rights under the law.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please read this privacy policy carefully and ensure that you understand it.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your acceptance of our privacy policy is deemed to occur upon your first visit to our website or\n              registering your details onto our Ring My Dog &#8211; The Wanted Dog Poster App.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You will be required to read and accept this Privacy Policy when registering for an account.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">If you do not accept and agree with this Privacy Policy, We advice you must stop using our\n              website and</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Ring My Dog &#8211; The Wanted Dog Poster App immediately.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Definitions and Interpretations</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">In our Privacy Policy the following terms shall have the following meanings:<strong></strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong>\u201cAccount\u201d</strong> &#8211; means an account created by you the user required to access\n              and / or use certain areas and features of our site / app.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong>\u201cCookie\u201d</strong> &#8211; means a small text file placed on your computer or device by\n              our site when you visit certain parts of Our website www.ringmydog.com and certain features of\n              our Ring My Dog &#8211; The Wanted Dog Poster App. Details of the Cookies used by our website\n              are set out in our Cookies Policy.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><strong>\u201cCookies Law\u201d</strong> &#8211; </span>means the relevant\n              parts of the Privacy laws as part of the new GDPR, Regulations.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><strong>\u201cPersonal data\u201d</strong> &#8211; means any and all data\n                that relates to an identifiable person who can be directly or indirectly identified from\n                that data. In this case, it means personal data that you supply to us via our website or\n                app. This definition shall, where applicable, incorporate the definitions provided in the\n                <br />EU Regulations 2016/679 &#8211; the General Data Protection Regulation (\u201dGDPR\u201d)\n                and<br /><strong>\u201cWe/Us/Our\u201d</strong> &#8211; means Ring My Dog Limited is registered in\n                England under company number 12501081, our registered address is 16 Harlech House,\n                Carnaravon Road, Clacton on Sea, Essex, C015 6QB.</span><span\n                style=\"font-size: 14px;\"></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Information about us</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our website www.ringmydog.com is owned by Ring My Dog Limited registered in England under company\n              number 12501081.<strong></strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our registered address is 16 Harlech House, Carnaravon Road, Clacton on Sea, Essex, CO15\n              6QB.<strong></strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />What Does This Policy Cover?</strong><span></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">This Privacy Policy applies only to your use of Our website and / or app.<strong></strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our site and / or app may contain links to other websites.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please note that We have no control over how your data is collected, stored, or used by other\n              websites and We advise you to check the Privacy Policy of such websites before providing any\n              data to them.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Your Rights</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">As a data subject, you have the following rights under the GDPR, which this Policy and Our use of\n              personal data have been designed to uphold.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Some of the rights are complex, and not all the details have been included in Our Summaries.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right to be informed about Our collection and use of personal data;</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right of access to the personal data We hold about you;</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right to rectification if any personal data We hold about you is inaccurate or incomplete\n              <br />(please contact Us)<br /><a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span>The right to be forgotten &#8211; example, the right to ask Us to\n                delete any personal data that we hold about you.</span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We only hold your personal data for a limited time. If you would like us to delete your data\n              sooner (please contact Us)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right to restrict (example) the processing of your personal data;</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right to data portability (obtaining a copy of your personal data to re &#8211; use with\n              another service or organisation)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">The right to object to Us using your personal data for particular purposes; and Rights with\n              respect to automated decision making and profiling.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">If you have any cause of complaint about Our use of your personal data, please contact Us.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We will do Our best to solve the problem for you. If we are unable to help, you also have the\n              right to lodge a complaint with the UK&#8217;s supervisory authority, the Information\n              Commission&#8217;s Office (IPO)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">For further information about your rights, please contact the Information Commission&#8217;s.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Office or your local Citizens Advice Bureau.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />What Data Do We Collect?</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Depending upon using Our website or registering to use Our app, We will collect some.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">if not all of the following personal and non &#8211; personal data.<br />(please see our Cookie\n              Policy)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Title</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Name</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Address</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Postcode.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Country of Residence</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your email address</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your contact mobile number</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Name of your dog</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Breed of your dog</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Age of dog</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your 5 digit security pin</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Date your dog was stolen or lost.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Biometric upload of your dog image</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Web Browser Type and Version</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your IP Address</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Operating System</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">A list of URLs (starting with a referring site, your activity on Our website, and the website you\n              exit too)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />How Do We Use Your Data</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">All personal data is processed and stored securely. <br />(personal data is only stored as long\n              as you continue to use our services such as website or app)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We will comply with Our obligations and safeguard your rights under the GDPR at all times.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our use of your personal data will always have a lawful basis, either because it is necessary for\n              Our performance of a contract with you, because you have consented to.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our use of your personal data.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your personal data (example subscribing to emails) or because it is in Our legitimate interest.\n            </p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Specifically, We may use your data for the following purposes:</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Providing and managing your account;<br />Providing and Managing your access to Our\n              site;<br />Personalising and tailoring your experiences on our website and app.<br />Supplying\n              Our products and services to you. (please note we need your personal data in order to enter into\n              a contract with you)<br />Personalising and tailoring Our products and services for\n              you.<br />Replying to emails from you.<br />Supplying you with emails that you have opted into.\n              <br />(you may unsubscribe or opt-out anytime by requesting via our \u201cContact Us\u201d page on our\n              website) <br /><a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Providing Your Personal Data To Others</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">With your permission and / or where permitted by law, we may also use your data for marketing\n              purposes which may include contacting you by email / or telephone or text messages with\n              information, news and offers on Our products and / or services.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We will not , however, send you any any unsolicited marketing or spam and will take all\n              reasonable steps to ensure that We fully protect your rights and comply with our obligations\n              under the GDPR guidelines.</p>\n            <p  style=\"font-weight: bold; color: #5C2508;\">You have the right to withdraw your consent to Us using your personal data at any time We will\n              only keep your data for as long as you are using our services.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Data will therefore be retained for the following periods;<br />Until such time as we no longer\n              need the personal details in order to perform Function (s)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />How and Where Do We Store Your Data</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We only keep your personal data for as long as We need to in order to use it as Described above,\n              and / or for as long as We have your permission to keep using your personal data.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Your data We collect when you register to use Ring My Dog- The Wanted Dog Poster App as well as\n              Our hosting (<a href=\"https://www.ringmydog.com\">www.ringmydog.com</a>) facilities are looked\n              after by Godaddy Operating Company .</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Amazon Web Services Ireland Limited, are currently based at One Burlington Plaza, Burlington\n              Road, Dublin 4.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">If we use services outside of the European Commission in America or Asia Zones then The European\n              Commission has made \u201cadequacy decision\u201d with respect to the data protection laws of each of\n              these countries.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Transfers to each of these countries will be protected by appropriate safeguards, namely the use\n              of standard data protection clauses adopted<br />or approved by the European Commission.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Data security is very important to Us, and to protect your data We have taken suitable measures\n              to safeguard and secure data collected through Our website and app.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Do We Share Your Data</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Unless, as listed below, we will only share your personal data with the Petlog.com Company, as\n              per Our contract with you to do so In certain circumstances, We may be legally required to share\n              certain data held by Us which may include your personal data, example, where we may be involved\n              in legal proceedings, where We are complying with legal obligations such as a court order or a\n              governmental authority.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We may share your data with other partner &#8211; data processors and in our group for product\n              specification and marketing.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We may contract with third parties to supply products and services to you on Our behalf.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">These may include payment processing, delivery of goods such as search engine Facilities.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Advertising and Marketing</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">In some cases, the third parties may require access to some or all of your data.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Where any of your data is required for such purpose, We will take all reasonable steps to ensure\n              your data will be handled safely, securely, and in accordance with your rights, our obligations,\n              and the obligations of the third party under the law.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We may compile statistics about the use of Our Website including data on traffic, usage patterns,\n              user numbers, sales, and other information.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">All such data will be anonymised and will not include any personally identifying data, or any\n              anonymised data that can be combined with other data and used to identify you.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We may from time to time share such data with third parties such as prospective Investors\n              affiliates, partners and advertisers.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Data will only be shared and used within the bounds of the law.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Where we transfer any data outside the EEA, We will take all reasonable steps to ensure that your\n              data is treated as safely and securely as it would be within the the UK and under the Data\n              Protection Act 1998.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">In certain circumstances, we may be legally required to share certain data held by us.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">This may include your personal data, for example, where We are involved in legal proceedings,\n              where We are complying with legal requirements such as a court order or a governmental\n              authority.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><br /><strong>What Happens If Our Business Changes\n                  Hands?</strong></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">From time to time, Our business may expand or reduce. This may involve the sale or transfer of\n              control of all or part of our business.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Any personal data that you have provided to Us, where it is relevant to any part of Our business\n              that is being transferred, the new owner. or controlling party will, under the terms of this\n              Privacy Policy, be permitted to use that data only for the same purposes for which it was\n              originally collected by Us.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span>In the event that your data is to be transferred in such a manner,\n                We will contact you </span>in advance and inform you of the changes.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">This will give you the choice to have your data deleted or withheld from the new owner or\n              controller.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><br /><strong>Your Right To Withhold Information</strong></span>\n            </p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You may access certain areas of Our Website without providing any data at all.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">However, to use all the features and functions available on Our website you may be required to\n              submit or allow permission for the collection of certain data.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong>You can restrict Our use of Cookies</strong></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">For more information, please see our Cookies Policy.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><br /><strong>Access To Your Data</strong></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You can request a copy of any personal data held by Us (where such data is held)</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Under the GDPR, no payment is required, and We will provide any and all information in response\n              to your request totally free of charge.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please contact Us at: <a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><br /><strong>Our Use of Cookies</strong></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our website may place and access certain first party Cookies on your computer or device.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">First Party Cookies are placed by Us and are used only by Us.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We use Cookies to facilitate and to improve your experience of our website and to provide and\n              improve Our product services.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">These Cookies are carefully chosen and we have taken steps to ensure that your Privacy and\n              personal data is protected and respected at all times.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">All Cookies used by Us are used in accordance with current Cookie Law.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Before we proceed to place Cookies on your computer or device, you will be shown a popup asking\n              your permission to use these Cookies.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">By giving your consent to placing these Cookies you are enabling Us to provide the best possible\n              experience and service for you.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">There are certain features of Our Website that depend on Cookies to function.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Cookie Law deems these Cookies \u201cstrictly necessary\u201d.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">However you may still wish to block these Cookies simply by changing your internet browser.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please be aware that blocking these Cookies will affect the performance of our Website.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><span><br /><strong>Contacting Us And Our Details</strong></span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">This Website and the App (Ring My Dog &#8211; The Wanted Dog Poster App) is owned by Ring My Dog\n              Limited</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We are registered in England and Wales under the registration number 12501081</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our registered offices at Ring My Dog Limited</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">16 Harlech House, Carnaravon Road, Clacton on Sea, Essex, CO15 6QB</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You can contact Us by post.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Or make contact using our website contact form.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You can contact using our office number <br /><span>+44 (0) 7748125442</span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">You can also contact Us by our email address;<br /><a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">If you have any questions or queries regarding Our website or Our Privacy Policy.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please contact Us at: <a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please ensure that your query is detailed and clear, especially if you are requesting information\n              about the data We hold about you.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our Privacy Policy will change from time to time according to the Law.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">All changes will be updated onto Our Website and you will be deemed to have accepted the new\n              terms of the Privacy Policy once you revisit Our Website following any updates to our Privacy\n              Policy.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">We are registered as a data controller with the Information Commissioner&#8217;s Office.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our data protection registration number is ZA704552</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Our representative within the European Union with respect to Our obligations under data\n              protection law is Joseph Edet.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Please contact him through;</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">sending your enquiries by post to Our postal address given above.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">By using our website contact form.</p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Or by Our contact number: <br /><span>+44 (0)\n                7748125442</span></p>\n            <p style=\"font-weight: bold; color: #5C2508;\">Or by email: <a href=\"mailto:contact@ringmydog.com\"\n                >contact@ringmydog.com</a></p>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Contacting Us And Our Details</strong><strong\n                style=\"font-size: 14px;\"></strong></p>\n            <ul>\n              <li style=\"font-weight: bold; color: #5C2508;\">This Website and the App (Ring My Dog &#8211; The Wanted Dog Poster App) is owned by Ring My\n                Dog Limited.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">We are registered in England and Wales under the registration number 12501081.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Our registered offices at Ring My Dog Limited are;</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">16 Harlech House, Carnarvon Road, Clacton on Sea, Essex, CO15 6QB</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">You can contact us by post.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Or make contact using Our Website contact form.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">You can contact using Our office number <br />+44 (0) 7748125442</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">You can also contact Us by email: <a href=\"mailto:contact@ringmydog.com\"\n                  >contact@ringmydog.com</a>\n            </ul>\n            <ul>\n              <li style=\"font-weight: bold; color: #5C2508;\">We are registered as a data controller with the Information Commissioner&#8217;s Office.\n              </li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Our data protection registration number is ZA7O4552</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Our representative within The European Union with respect to Our obligations under Data\n                Protection Law is Joseph Edet.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Please contact him through;</li>\n            </ul>\n            <p style=\"font-weight: bold; color: #5C2508;\"><strong><br />Sending your enquiries by post to Our postal address,\n                given above.</strong><strong></strong></p>\n            <ul>\n              <li style=\"font-weight: bold; color: #5C2508;\">By using Our Website contact form.</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Or by Our contact number <br />+44 (0) 7748125442</li>\n              <li style=\"font-weight: bold; color: #5C2508;\">Or by email: <a href=\"mailto:contact@ringmydog.com\"\n                  >contact@ringmydog.com</a>\n            </ul>\n  </body>\n  \n  </html>"},BUTTON_LABELS:{NEXT:'NEXT',BACK:'BACK',SIGNUP:'SIGNUP',LOGIN:'LOGIN',SUBMIT:'SUBMIT',BIOMETRIC:'BIOMETRIC DOG BREED SCANNER ',SAVE:'SAVE',CONTACT:'CONTACT',TRACK:'TRACK'},PLACEHOLDERS:{YOU_AGREE_TO_OUR:' By creating your account, you agree to our',TERMS_CONDITIONS:'Terms & Conditions / Privacy Policy',RING_MY_DOG_LIMITED:'RING MY DOG LIMITED 2019',SIGNUP_NOW:'SIGNUP NOW',USERNAME:'Username',PASSWORD:'Password',CONFIRM_PASSWORD:'Confirm Password',LOGIN_NOW:'LOGIN NOW',CREATE_FIVE_DIGIT_SECURIRY_PIN:'Create five digit securiry pin',DOG_NAME:'Dog name',DOG_AGE:'Dog age',DOG_BREED:'Dog breed',DOG_COLOR:'What color is your dog',SPECIAL_MARKING:'Any special marking on dog',DOG_PROFILE:'DOG PROFILE',TITLE:'Title',FIRST_NAME:'First name',MIDDLE_NAME:'Middle name (Optional)',SURNAME:'Surname',COUNTRY_OF_RESIDENCE:'Country of residence',HOME_ADDRESS:'Home address',MOBILE_NUMBER:'Mobile number',HOME_NUMBER:'Home number (Optional)',REWARD:'A reward is offered',FAVOURITE_COLOR:"What is your father's first name?",FAVOURITE_TEACHER:'What was the name of your first school?',DOG_REGISTRATION_NUMBER:'Dog chip registration number ',OWNER_NAME:'Your name',OWNER_CONTACT_NUMBER:'Your contact number',OWNER_ADDRESS:'Your address',NEW_OWNER_NAME:'New owners name',NEW_OWNER_CONTACT_NUMBER:'New owners contact number',NEW_OWNER_ADDRESS:'New owners address',PROFILE_TYPE:'User type',FULLNAME:'Full name',ADDRESS:'Address',CONTACT_NUMBER:'Contact number',NAME_OF_DOG_BREEDING_BUSINESS:'Name of dog breeding business',ADDRESS_OF_DOG_BREEDING_BUSINESS:'Address of dog breeding business',DOG_MISSING_DATE:'Date your dog went missing',DOG_MISSING_COUNTRY:'Country of residence where dog went missing',DOG_MISSING_AREA:'Area where dog went missing',DOG_MISSING_CIRCUMSTANCES:'Circumstances how dog went missing'},INFORMATION_SCREEN:{TITLE:'INFORMATION ABOUT\nRING MY DOG - THE WANTED DOG POSTER APP',HTML:"<!DOCTYPE html>\n    <html lang=\"en\">\n      <head>\n        <meta charset=\"UTF-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n        <title>Story - Ring My Dog Limited</title>\n        <style>\n          \n        </style>\n      </head>\n      <body>\n        <div>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >This app was designed to help dog owners across the uk, as well\n              as parts of the world find their lost or stolen pet dogs.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Most responsible pet owners, have their pet dogs micro-chipped, with\n              their dogs details and their personal details.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >This is absolutely a fantastic idea, one that, Ring My Dog \u2013 The\n              Wanted Dog Poster App totally agrees with.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >But realistically we all know that micro-chipping your pet dog is\n              only effective if your beloved pet dog has been found and scanned\n              correctly.\n            </span>\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Also that you the owner have kept your personal contact details\n              regarding your dogs micro-chip upto date.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >All that said, what about the pet dog owners out there, who have all\n              micro-chipped their pet dogs, and now find that their pet dogs are\n              lost or stolen.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Spare a thought for those pet dog owners, who used trackers on their\n              pet dogs that are now missing.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Putting a tracker around your pet dog\u2019s neck is simply not good\n              enough.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Imagine, your pet wanders off or is literally stolen, any tracker\n              around your pet dogs neck, would simply be removed and thrown\n              away.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >This renders your pet lost, maybe for ever even though your dog is\n              micro-chipped.\n            </span>\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >The amazing thing is that lost or stolen dogs do not forget their\n              owners.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >If your lost pet dog was introduced to your smell, or voice your pet\n              dog would automatically remember you.\n            </span>\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span></span><strong>How unique is that.</strong></p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Did you know that your beloved pet dogs nose is even more unique than\n              that.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><strong>Did you know that your beloved pet dogs:</strong></p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Nose, snout, leather or any other name that you may have for\n              your dogs nose, is as unique to your individual pet dog, as your\n              finger prints are to you.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span>At </span\n            ><span \n              >Ring My Dog \u2013 The Wanted Dog Poster App</span\n            ><span\n              >, we believed that this was so unique to a dog that we wanted to be\n              the first to create a special app using this unique feature of a dogs\n              nose, to track and identify lost and stolen pet dogs.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span>Once you have downloaded the </span\n            ><span \n              >Ring My Dog \u2013 The Wanted Dog Poster App</span\n            ><span>, you must complete the following:</span>\n          </p>\n          <ul>\n            <li style=\"font-weight: bold; color: #5C2508;\"><span>Read and agree our terms and conditions. </span></li>\n            <li style=\"font-weight: bold; color: #5C2508;\"><span>Create username</span></li>\n            <li style=\"font-weight: bold; color: #5C2508;\"><span>Create a password (minimum 8 character)</span></li>\n          </ul>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >Your password must be strong please keep safe and do not share with\n              anyone.</span\n            >\n          </p>\n          <ul>\n            <li style=\"font-weight: bold; color: #5C2508;\">\n              <span\n                >Use the username and password that you have created to login to\n              </span>\n            </li>\n          </ul>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span \n              >Ring My Dog \u2013 The Wanted Dog Poster App</span\n            >\n          </p>\n          <ul>\n            <li style=\"font-weight: bold; color: #5C2508;\"><span>Create a 5 digit security pin using numbers only.</span></li>\n          </ul>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span\n              >It is very important that you keep this 5 digit pin absolutely safe,\n              and not share with anyone else.</span\n            >\n          </p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>This 5 digit pin will be needed to do the following:</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\">\n            <span>Summit your dog profile <br /></span\n            ><span>Summit your personal details <br /></span\n            ><span>Edit your dog\u2019s profile <br /></span\n            ><span>Transfer your dog to a new owner <br /></span\n            ><span>Edit your personal details <br /></span\n            ><span>Broadcast to other app users<br /></span\n            ><span>Create new dog profiles<br /></span\n            ><span\n              >Delete your account<br /><span\n                >Delete your pet dog account<br /></span\n              ><span>Sell your dog<br /></span\n              ><span>Sell puppies</span></span\n            >\n          </p>\n        </div>\n        <ul>\n          <li style=\"font-weight: bold; color: #5C2508;\"><span >Create your dog profile</span></li>\n          </ul>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span >We use our own biometric scanner only compatible with <br /></span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Once your pet dog has been scanned and a dog profile has been created for your pet dog, no other scan or profile can be created using the </span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span>, unless you the owner inputs your 5 digit security pin to:</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Edit dog profile<br /></span><span>Transfer dog details<br /></span><span>Sell dog to new owner<br /></span><span>Delete dog account</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>If your pet dog is lost or stolen,  and out there somewhere, someone attempts to scan your pet dog&#8217;s nose even to check if there is a </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span >, profile you the genuine owner will receive a notification on your phone, detailing :</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Date someone tried to re-scan your pet dog.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>The time of the attempted scan.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>The precise location. </span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>You will also receive notification of the </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span> user who made the attempt  to re-scan your pet dog.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>The user attempting to scan your dog will see the </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span> and details of your dogs profile including your contact details </span><span >on their phone.</span></p>\n          <ul>\n          <li style=\"font-weight: bold; color: #5C2508;\"><span>Broadcast to other </span></li>\n          </ul>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span>,  across the UK and parts of the world.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>This will make it very difficult for those who steal family pets to breed.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Makes it difficult to advertise on social media dogs that are stolen </span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Shop windows<br /></span><span>Supermarket boards<br /></span><span>Local newspapers<br /></span><span>Dog magazines<br /></span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span></span><strong>Why !</strong></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Because the, </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span> gives all the genuine dog lovers across the UK, north, east,  south, west and across the world the abilities to scan a parent dog to ensure that the dog is not on the, </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span>. </span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Or that the dog has been broadcasted as lost or stolen.</span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><strong>How unique is that.</strong></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Join the, </span><span >Ring My Dog \u2013 The Wanted Dog Poster App</span><span>, community. </span></p>\n          <p style=\"font-weight: bold; color: #5C2508;\"><span>Download today.</span></p></div>\n          \n      </body>\n    </html>\n    "},DRAWER:{EDIT_DOG_PROFILE:'Edit dog profile',TRANSFER_DOG:'Transfer dog to new owner ',ADD_MORE_DOGS:'Add more dogs',DELETE_DOG_PROFILE:'Delete dog profile',DELETE_ACCOUNT:'Delete your profile ',LOGOUT:'Logout',SCAN_DOGE_NOSE:'Scan dog nose',RESET_PIN:'Reset five digit security pin',DOG_BREEDER:'Dog breeder',MISSING_DOG_LIST:'Broadcast missing dog list',THANKS_MESSAGE:'Send thanks message to the ring my dog-the wanted poster app community',NOTIFICATION:'Notification'}}}),885,[]);
